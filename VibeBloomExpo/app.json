{
  "expo": {
    "name": "VibeBloom",
    "slug": "vibebloom-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F9FE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rafael.vibebloom.expo",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VibeBloom usa tu ubicación para ordenar los lugares cercanos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F9FE"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.rafael.vibebloom.expo",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
