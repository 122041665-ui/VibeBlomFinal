FROM node:22-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY resources ./resources
COPY vite.config.js ./
COPY postcss.config.js tailwind.config.js ./
RUN npm run build

FROM php:8.4-apache

ENV APACHE_DOCUMENT_ROOT=/var/www/html/public
WORKDIR /var/www/html

RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf g++ git libzip-dev make unzip zip \
    && docker-php-ext-install pdo_mysql zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && a2enmod rewrite headers remoteip \
    && rm -rf /var/lib/apt/lists/*

RUN printf "upload_max_filesize=8M\npost_max_size=24M\nmax_file_uploads=10\nexpose_php=Off\n" \
    > /usr/local/etc/php/conf.d/vibebloom.ini

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY . .
COPY --from=assets /app/public/build ./public/build
COPY docker/apache-vhost.conf /etc/apache2/sites-available/000-default.conf

RUN composer install --no-dev --classmap-authoritative --no-interaction \
    && ln -sfn ../storage/app/public public/storage \
    && chown -R www-data:www-data storage bootstrap/cache database

EXPOSE 8000

CMD ["apache2-foreground"]
