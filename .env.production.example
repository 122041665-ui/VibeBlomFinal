# Copia este archivo como .env.production. Nunca subas el archivo real.
WEB_DOMAIN=web.example.com
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com

APP_KEY=base64:GENERA_UNA_CLAVE_CON_PHP_ARTISAN_KEY_GENERATE
JWT_SECRET=GENERA_AL_MENOS_64_CARACTERES_ALEATORIOS
FLASK_SECRET=GENERA_OTRA_CLAVE_ALEATORIA_DISTINTA

MYSQL_HOST=mysql-private.example.internal
MYSQL_PORT=3306
MYSQL_DATABASE=vibebloom
MYSQL_USERNAME=vibebloom_app
MYSQL_PASSWORD=CAMBIAR

OPENAI_API_KEY=CAMBIAR
MAPBOX_TOKEN=CAMBIAR

# Orígenes web autorizados, separados por coma.
CORS_ORIGINS=https://web.example.com,https://admin.example.com
